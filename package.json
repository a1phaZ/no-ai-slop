{
  "name": "no-ai-slop",
  "version": "0.4.0",
  "private": true,
  "description": "Chrome-расширение, скрывающее AI-сгенерированные посты на Reddit",
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "node scripts/package.mjs",
    "train": "node training/train.mjs",
    "data:human": "node training/fetch-human.mjs",
    "data:public": "node training/import-public.mjs --hc3",
    "data:ai": "node training/generate-ai.mjs",
    "data:dedup": "node training/dedup.mjs",
    "data:build": "node training/build-dataset.mjs",
    "data:labels": "node training/import-labels.mjs",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "happy-dom": "^15.0.0",
    "typescript": "^5.6.0"
  }
}
